{
  "name": "@tegroton/tegro-money",
  "version": "0.2.0",
  "description": "Minimal, production-ready Tegro.Money integration for Telegram bots: createOrder helper + webhook verifier + working grammY example.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "example:bot": "tsx examples/minimal-bot.ts",
    "example:webhook": "tsx examples/express-webhook.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "keywords": [
    "tegro",
    "tegro-money",
    "telegram",
    "telegram-bot",
    "grammy",
    "payments",
    "rub",
    "sbp",
    "fiat-onramp",
    "tegroton"
  ],
  "author": "TegroTON",
  "license": "MIT",
  "homepage": "https://github.com/TegroTON/ai-telegram-pay-miniapp#readme",
  "bugs": {
    "url": "https://github.com/TegroTON/ai-telegram-pay-miniapp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TegroTON/ai-telegram-pay-miniapp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.8.0",
    "express": "^4.18.2",
    "grammy": "^1.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "grammy": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "grammy": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}

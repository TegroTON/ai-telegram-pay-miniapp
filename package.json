{
  "name": "tegro-money-telegram",
  "version": "0.1.0",
  "description": "Minimal, production-ready Tegro.Money integration for Telegram bots: createOrder helper + webhook verifier + working grammY example.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "example:bot": "tsx examples/minimal-bot.ts",
    "example:webhook": "tsx examples/express-webhook.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "keywords": [
    "tegro",
    "tegro-money",
    "telegram",
    "telegram-bot",
    "grammy",
    "payments",
    "rub",
    "sbp",
    "fiat-onramp"
  ],
  "author": "DeFiTON",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeFiTON/tegro-money-telegram.git"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "express": "^4.18.2",
    "grammy": "^1.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "grammy": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "grammy": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
